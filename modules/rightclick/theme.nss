theme
{
	name="modern"
	dark=true
	view=view.medium

	background
	{
		color=#100708
		opacity=100
		effect=0
	}

	border
	{
		enabled=true
		size=1
		color=#8b0a1e
		opacity=100
		radius=3
		padding=[4, 6, 4, 6]
	}

	shadow
	{
		enabled=true
		size=16
		color=#000000
		opacity=70
		offset=5
	}

	item
	{
		radius=3
		prefix=1
		padding=[10, 5, 14, 5]
		margin=[2, 1, 2, 1]
		text
		{
			normal=#e9dadc
			select=#ffffff
			normal.disabled=#5c4044
			select.disabled=#5c4044
		}
		back
		{
			normal=#100708
			select=#3a0d17
			normal.disabled=#100708
			select.disabled=#100708
		}
		border
		{
			normal=#100708
			select=#dc143c
			normal.disabled=#100708
			select.disabled=#100708
		}
	}

	separator
	{
		size=1
		color=#2a1217
		opacity=100
		margin=[12, 4, 12, 4]
	}

	symbol
	{
		normal=#8b0a1e
		select=#ff5c7a
		normal.disabled=#3a1418
		select.disabled=#3a1418
		chevron
		{
			normal=#8b0a1e
			select=#ff5c7a
			normal.disabled=#3a1418
			select.disabled=#3a1418
		}
		checkmark
		{
			normal=#dc143c
			select=#ffffff
		}
		bullet
		{
			normal=#dc143c
			select=#ffffff
		}
	}

	image
	{
		enabled=true
		color=[#dc143c, #ff8fa3, #2a1012]
		gap=10
		align=2
	}

	font
	{
		name="Segoe UI"
		size=13
		weight=4
	}
}
