{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "__LOGO__",
    "color": { "1": "red", "2": "white" },
    "padding": { "top": 1, "left": 1, "right": 4 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "red", "title": "red" }
  },
  "modules": [
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "os " },
    { "type": "kernel",   "key": "ker" },
    { "type": "uptime",   "key": "up " },
    { "type": "wm",       "key": "wm " },
    { "type": "cpu",      "key": "cpu" },
    { "type": "gpu",      "key": "gpu" },
    { "type": "memory",   "key": "mem" },
    { "type": "display",  "key": "mon" },
    "break",
    "colors"
  ]
}
